# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Used by both the `mongo` service in docker-compose.yml AND the API. The API
# constructs its connection URI from these values.
MONGO_USERNAME=anveksha
MONGO_PASSWORD=changeme
MONGO_DATABASE=anveksha

# Host/port are container-local in Compose; override if you point at an
# externally-managed Mongo (e.g. Atlas) — set MONGO_URI directly to skip
# the auto-build.
MONGO_HOST=mongo
MONGO_PORT=27017
# Optional escape hatch — if set, the API uses this verbatim and ignores
# the five fields above. Useful for Atlas / managed clusters.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/anveksha

# ─── API ─────────────────────────────────────────────────────────────────────
# DEBUG enables dev-token auth (matching the frontend's mock dev-login) and
# loosens a few safety checks. Turn off in production.
DEBUG=true
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Forward-looking — JWT secret used by the auth module when issuing real
# tokens (Google OAuth flow). Not used while DEBUG dev-tokens are in play.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14
