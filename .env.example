# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Both values come from the Supabase dashboard → your project → Connect.
# DATABASE_URL: the pooled connection string, Supavisor TRANSACTION mode,
#   port 6543 — used for all runtime app traffic.
# DATABASE_MIGRATION_URL: the direct (non-pooled) connection string, port
#   5432 — used ONLY by Alembic for schema migrations.
# Both look like: postgresql+psycopg://<user>:<password>@<host>:<port>/postgres
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_ECHO=false

# Per-instance connection pool held against DATABASE_URL. Kept small —
# multiply by however many app instances run to size against Supavisor's
# own connection budget, not per-request.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_S=1800

# Local Postgres for the test suite (docker-compose --profile test up
# postgres-test) — NOT the Supabase project above. Point pytest at this
# when running outside Docker; adjust host if running against the
# containerized DB from another container instead of the host.
TEST_DATABASE_URL=postgresql+psycopg://anveksha_test:anveksha_test@localhost:55432/anveksha_test

# ─── API ─────────────────────────────────────────────────────────────────────
# DEBUG enables dev-token auth (matching the frontend's mock dev-login) and
# loosens a few safety checks. Turn off in production.
DEBUG=true
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth — must match the frontend's VITE_GOOGLE_CLIENT_ID so the
# ID tokens the GoogleLogin button produces pass the audience check here.
# Leave empty to keep google-register as a DEBUG-only stub.
GOOGLE_CLIENT_ID=

# Forward-looking — JWT secret used by the auth module when issuing real
# tokens (Google OAuth flow). Not used while DEBUG dev-tokens are in play.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14
